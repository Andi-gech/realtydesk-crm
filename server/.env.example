# RealtyDesk Server Configuration
PORT=4000

# MongoDB Connection String:
# For local MongoDB: mongodb://localhost:27017/realtydesk
# For MongoDB Atlas (cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/realtydesk?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/realtydesk?retryWrites=true&w=majority

# JWT Token Secrets — REQUIRED, must be unique and at least 32 characters.
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start while these placeholders are unchanged.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHAR_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Bootstrap Owner Credentials (seeded via `npm run seed`)
SEED_OWNER_EMAIL=owner@your-brokerage.com
SEED_OWNER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SEED_ORG_NAME=My Brokerage
